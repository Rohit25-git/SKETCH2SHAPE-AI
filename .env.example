# ==============================================================================
# SKETCH2SHAPE AI - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      Windows PowerShell: Copy-Item .env.example .env
#      Linux / macOS:      cp .env.example .env
# 2. Populate the optional API keys below.
# 3. DO NOT commit your populated '.env' file to Git!
# ==============================================================================

# Application Metadata
PROJECT_NAME="SKETCH2SHAPE AI"
VERSION="1.0.0"

# Server Network Configuration
HOST="127.0.0.1"
PORT=8000

# Default 3D Reconstruction Engine
# Options:
#   - "local_manifold" (Default: Local deterministic manifold SDF + Marching Cubes, 0 API keys required)
#   - "cloud_tripo"    (Optional: Requires TRIPO_API_KEY)
#   - "cloud_meshy"    (Optional: Requires MESHY_API_KEY)
DEFAULT_ENGINE="local_manifold"

# Multimodal Vision Analysis (Groq LPU)
# Optional: Used for fast semantic object interpretation (qwen/qwen3.8-27b).
# If omitted or offline, SKETCH2SHAPE AI automatically uses its built-in local
# Computer Vision topological contour classifier.
# Obtain a key at: https://console.groq.com
GROQ_API_KEY="your_groq_api_key_here"

# Optional Cloud Generative 3D Mesh Providers
# If configured, unlocks remote neural Large Reconstruction Model (LRM) inference.
# Tripo3D API: https://platform.tripo3d.ai
TRIPO_API_KEY=""

# Meshy API: https://www.meshy.ai
MESHY_API_KEY=""

# Hugging Face Access Token (Optional)
HF_TOKEN=""

# File Upload & Safety Constraints
MAX_UPLOAD_SIZE_MB=10
