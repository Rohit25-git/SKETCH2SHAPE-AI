# ============================================================
# SKETCH2SHAPE AI - Git Ignore Configuration
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Node & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.npm
*.tsbuildinfo

# Environment & Secrets (NEVER COMMIT CREDENTIALS)
.env
.env.local
.env.*.local
*.env
!.env.example

# Runtime Local Storage (Keep folder structure via .gitkeep, exclude user uploads and generated meshes)
storage/uploads/*
!storage/uploads/.gitkeep
storage/processed/*
!storage/processed/.gitkeep
storage/models/*
!storage/models/.gitkeep
storage/metadata/*
!storage/metadata/.gitkeep
storage/fresh_audit/

# Scratch, Experiments & Debugging Scripts
scratch/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Operating System Artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
